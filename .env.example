# Copy this file to ".env" and edit the values. Never commit ".env".

SECRET_KEY=mouri@20073
ADMIN_TOKEN=qwertyuiop

# Display time zone. Times are stored in UTC and shown in this zone.
DISPLAY_TIMEZONE=Asia/Kolkata

# A notice not confirmed by a successful source check within this many minutes is shown as STALE.
FRESHNESS_MINUTES=360

# How often each source is checked by the scheduler.
REFRESH_INTERVAL_MINUTES=15
ENABLE_SCHEDULER=false

# Demo mode: sample notices, clearly labelled. Set to false when only approved live sources are used.
ENABLE_DEMO_SOURCE=true

# Optional: JSON file describing approved live sources (see docs/SOURCE_APPROVAL.md).
LIVE_SOURCES_FILE=

# HTTP behaviour for live sources.
REQUEST_TIMEOUT=10
MAX_RETRIES=3
BACKOFF_SECONDS=1.5
MIN_REQUEST_INTERVAL=5
USER_AGENT=TransitNoticeBot/1.0 (student project; contact: your-email@example.com)

# Optional e-mail delivery. Leave SMTP_HOST empty to use demo (log-only) notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=

# Weather panel (Open-Meteo.com: free for non-commercial use, no key, needs internet).
WEATHER_ENABLED=true
WEATHER_LAT=13.0827
WEATHER_LON=80.2707
WEATHER_LABEL=Demo map area

# Street map tiles come from OpenStreetMap and need internet. Set false to show pins on a blank map.
MAP_TILES_ENABLED=true
MAP_CENTER_LAT=13.0827
MAP_CENTER_LON=80.2707
